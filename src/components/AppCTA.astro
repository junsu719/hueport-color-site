---
import { buildPlayStoreUrl, buildAppStoreUrl, type PageType } from '../lib/utm';

export interface Props {
  pageType: PageType;
  pageSlug: string;
  message?: string;
}
const {
  pageType,
  pageSlug,
  message = 'Spotted this color in the real world? Capture it instantly with HuePort.',
} = Astro.props;

const playStoreUrl = buildPlayStoreUrl(pageType, pageSlug);
const appStoreUrl = buildAppStoreUrl(pageType, pageSlug);
---
<div class="rounded-xl border border-neutral-200 bg-neutral-50 p-6">
  <div class="flex flex-col items-center gap-4 text-center sm:flex-row sm:text-left">
    <img
      src="/app-icon.jpg"
      alt="HuePort app icon"
      width="56"
      height="56"
      loading="lazy"
      decoding="async"
      class="h-14 w-14 shrink-0 rounded-xl"
    />
    <p class="flex-1 text-lg">{message}</p>
    <div class="flex shrink-0 items-center gap-3">
      <a href={appStoreUrl} rel="noopener" aria-label="Download HuePort on the App Store">
        <img
          src="/app-store-badge.svg"
          alt="Download on the App Store"
          width="120"
          height="40"
          loading="lazy"
          decoding="async"
          class="h-10 w-auto"
        />
      </a>
      <a href={playStoreUrl} rel="noopener" aria-label="Get HuePort on Google Play">
        <img
          src="/googleplay-badge.webp"
          alt="Get it on Google Play"
          width="404"
          height="120"
          loading="lazy"
          decoding="async"
          class="h-10 w-auto"
        />
      </a>
    </div>
  </div>
</div>
